// x4 error code catalogue. One line per code: X4_ERR(code, name, "meaning / what to check")
// Codes are grouped by hundreds: 1xx power/safety, 2xx camera, 3xx storage, 4xx network,
// 5xx config, 6xx ui/input, 9xx internal. Never renumber; add new codes at the end of a group.
// docs/LOGGING.md is generated from this file by tools/gen_docs.py (do not edit the table there).

X4_ERR(100, POWER_BUS_OUT_ON,     "Core 5V bus output (BUS_OUT_EN) was found ON. Firmware forced it off. Check that nothing else enabled it.")
X4_ERR(101, POWER_OTG_ON,         "Core USB OTG output (USB_OTG_EN) was found ON. Firmware forced it off.")
X4_ERR(102, POWER_STATE_UNKNOWN,  "Could not read the AW9523B IO expander, so the 5V output state is unknown. Treat as unsafe; do not connect the rail.")
X4_ERR(103, BROWNOUT_RESET,       "Last reset was a brown-out. Rail sagged: check bank, wiring, capacitor, flash current.")
X4_ERR(104, FLASH_STUCK_ON,       "Flash GPIO stayed high longer than the hard cap. Forced off by the watchdog.")
X4_ERR(105, FLASH_REFUSED,        "Flash request refused (cooldown, disabled, too hot or busy). Informational.")
X4_ERR(106, OVERHEAT,             "Chip temperature above the throttle threshold. Streaming/bursts refused until it cools.")
X4_ERR(107, WATCHDOG_RESET,       "Last reset was a watchdog (task/interrupt). Something blocked a task; see the log tail.")
X4_ERR(108, PANIC_RESET,          "Last reset was a software panic/exception. Read the backtrace on serial.")
X4_ERR(200, CAM_INIT_FAIL,        "esp_camera_init() failed. Check the ribbon, power, and the pin map.")
X4_ERR(201, CAM_SENSOR_MISMATCH,  "Sensor PID is not the expected MEGA_CCM (0x039E). Firmware refuses to run the capture path.")
X4_ERR(202, CAM_CAPTURE_FAIL,     "esp_camera_fb_get() returned NULL or a frame that is not a JPEG.")
X4_ERR(203, CAM_NO_PSRAM,         "PSRAM not found or too small. Wrong board settings (needs OPI PSRAM) or a different module.")
X4_ERR(204, CAM_FRAME_TRUNCATED,  "JPEG did not end with FFD9: frame buffer too small for this quality/size. Raise cam_jpeg_buf_kb or lower quality.")
X4_ERR(205, CAM_SHOT_EXPIRED,     "Core asked for a shot the camera no longer holds (overwritten or timed out).")
X4_ERR(206, CAM_OLD_HW,           "Camera reports the old hardware revision (0x0200 != 0x01). M5 says it needs a patched esp32-camera build.")
X4_ERR(300, SD_MOUNT_FAIL,        "microSD did not mount. Card missing, not FAT32, or >16 GB (CoreS3 limit per M5 docs).")
X4_ERR(301, SD_WRITE_FAIL,        "Write to microSD failed or was short.")
X4_ERR(302, SD_FULL,              "microSD has less free space than one full shot needs.")
X4_ERR(303, SD_SLOW,              "SD write speed below the level needed for the 5 s budget.")
X4_ERR(400, NET_AP_FAIL,          "SoftAP failed to start.")
X4_ERR(401, NET_CAM_OFFLINE,      "A registered camera missed its heartbeats and is now offline.")
X4_ERR(402, NET_TRIGGER_TIMEOUT,  "A camera did not ACK a shoot command in time.")
X4_ERR(403, NET_TRANSFER_FAIL,    "Downloading a photo from a camera failed after all retries.")
X4_ERR(404, NET_JOIN_FAIL,        "Camera could not join the configured WiFi network.")
X4_ERR(405, NET_REGISTER_FAIL,    "Camera could not register with the Core.")
X4_ERR(406, NET_PROTO_MISMATCH,   "Peer speaks a different protocol version.")
X4_ERR(407, NET_TRANSFER_SLOW,    "All photos stored, but it took longer than the transfer budget.")
X4_ERR(500, CFG_CLAMPED,          "A config value was out of range or tried to loosen a safety limit; it was clamped.")
X4_ERR(501, CFG_MIGRATED,         "Stored config had an older version and was migrated.")
X4_ERR(502, CFG_UNKNOWN_KEY,      "Unknown config key in a request; ignored.")
X4_ERR(600, UI_SLOW_FRAME,        "An LVGL frame took longer than the budget (rate-limited warning).")
X4_ERR(900, INTERNAL,             "Internal error / assertion. Please report with the log tail.")
