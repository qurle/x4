{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "x4: build all (core)",
      "type": "shell",
      "command": "pio run",
      "options": {
        "cwd": "${workspaceFolder}/core"
      },
      "problemMatcher": [
        "$platformio"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
