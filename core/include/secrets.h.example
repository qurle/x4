// Copy to secrets.h (gitignored) and change the password before you use the rig anywhere public.
// Cameras must use the same values: camera/include/secrets.h.
// If secrets.h is missing the build uses this file and prints a warning.
#pragma once
#include "x4/version.h"

// The Core's own SoftAP (no router needed). WPA2 needs >= 8 characters.
#define X4_AP_SSID X4_PROJECT_NAME  // "x4cam", from x4/version.h
#define X4_AP_PASS "change-me-ap"

// OTA password for ArduinoOTA over the AP (Stage 5). Empty string = OTA disabled.
#define X4_OTA_PASS "change-me-ota"
