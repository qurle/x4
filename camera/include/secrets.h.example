// Copy to secrets.h (gitignored). Must match core/include/secrets.h for the AP values.
#pragma once
#include "x4/version.h"

// The Core's SoftAP (env cam1..cam4).
#define X4_AP_SSID X4_PROJECT_NAME  // "x4cam", from x4/version.h
#define X4_AP_PASS "change-me-ap"

// Your home/office WiFi, only used by env cam-hello (Stage 0 bench test before the Core exists).
#define X4_HOME_SSID "your-wifi"
#define X4_HOME_PASS "your-password"

// ArduinoOTA password (Stage 5). Empty string = OTA disabled.
#define X4_OTA_PASS "change-me-ota"
